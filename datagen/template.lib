/*
 * Acceptor trap density as a function of location
 * Statement: TRAP (ACCEPTOR)
 * Parameter: F.DENSITY
 * Arguments:
 * x          location x (microns)
 * y          location y (microns)
 * z          location z (microns)
 * *density   interface acceptor trap density(cm^-3)
 */
int acc_trap(double x,double y,double z,double *density)
{
    if (density == NULL)
    {
        printf("Error: density pointer is NULL\n");
        return(1); // 返回错误码
	}
    
    // 计算高斯分布的密度
    *density = (*density) * exp(-pow(y - 0.0, 2) / (2 * pow(1.0, 2)));
    
    // 如果密度小于最终密度，则设置为最终密度
    if (*density < 1.0e15) {
        *density = 1.0e15;
    }

    printf("acc_trap called with x=%.2f, y=%.2f, z=%.2f, d=%.2f\n", x, y, z,*density);

    return(0);
}

/*
 * Donor trap density as a function of location
 * Statement: TRAP (DONOR)
 * Parameter: F.DENSITY
 * Arguments:
 * x          location x (microns)
 * y          location y (microns)
 * z          location z (microns)
 * *density   interface donor trap density per cm^3
 */
int don_trap(double x,double y,double z,double *density)
{
    if (density == NULL)
    {
        printf("Error: density pointer is NULL\n");
        return(1); // 返回错误码
    }
	
    *density = *density - (*density - 1.0e15) * exp(-pow(((y - 100.0) / 100.0 - 1.0), 2) / (2 * pow(1.0, 2)));  // 密度递增

	printf("don_trap called with x=%.2f, y=%.2f, z=%.2f, d=%.2f\n", x, y, z,*density);

	return(0);
}

