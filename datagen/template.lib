/*
 * Thermal conductivity in GIGA
 * Statement: MATERIAL
 * Parameter: F.TCOND

 * Tl           Lattice temperature (K)
 * x            Location x (microns)
 * y            Location y (microns)
 * z            Location z (microns)
 * nd           Donor doping concentration (cm^-3)
 * na           Acceptor doping concentration (cm^-3)
 * xcomp	Composition fraction "X"
 * ycomp        Composition fraction "Y"
 * cond         return: Thermal conductivity (W/cm K) 
 * dconddt	return: Derivative of thermal conductivity wrt lattice temperature 
 */
int tcond(double Tl, double x, double y, double z, double nd, double na, double xcomp, double ycomp, double *cond, double *dconddt)
{
/*
 * The following body is set up to emulate the default function implemented
 * in ATLAS for silicon and polysilicon materials
 */
	double a,b,c;
	a=0.03;
	b=0.00156;
	c=1.65e-6;
	*cond=1.0/(a+Tl*(b+Tl*c));
	*dconddt=-(*cond)*(*cond)*(b+2.0*c*Tl);
	return(0);                /* 0 - ok */
}

/*
 * Thermal capacity in GIGA
 * Statement: MATERIAL
 * Parameter: F.TCAP

 * Tl           Lattice temperature (K)
 * x            Location x (microns)
 * y            Location y (microns)
 * z            Location z (microns)
 * nd           Donor doping concentration (cm^-3)
 * na           Acceptor doping concentration (cm^-3)
 * xcomp	Composition fraction "X"
 * ycomp        Composition fraction "Y"
 * cap          return: Thermal capacity (W/K cm^3) 
 * dcapdt	return: Derivative of thermal capacity wrt lattice temperature 
 */
int tcap(double Tl, double x, double y, double z, double nd, double na, double xcomp, double ycomp, double *cap, double *dcapdt)
{
/*
 * The following body is set up to emulate the default function implemented
 * in ATLAS for silicon and polysilicon materials
 */
        double a,b,c,d;
	a=1.97;
	b=0.00036;
	c=0.0;
	d=-37000.0;
	*cap=a+Tl*(b+Tl*c)+d/(Tl*Tl);
	*dcapdt=b+2.0*c*Tl-2.0*d/(Tl*Tl*Tl); 
	return(0);                /* 0 - ok */

}

