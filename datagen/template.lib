/*
 * Defect definition
 * Statement: DEFECTS
 * Parameter: F.DEFECTS
 * Arguments:
 * x          location x (microns)
 * y          location y (microns)
 * z          location z (microns)
 * *nta       density of acceptor-like tail states (cm^-3/eV)
 * *wta       characteristic decay energy for acceptor-like tail states (eV)
 * *nga       density of acceptor-like Gaussian states (cm^-3/eV)
 * *wga       characteristic decay energy for acceptor-like Gaussian states (eV)
 * *ega       peak energy for acceptor-like Gaussian states (eV)
 * *ntd       density of donor-like tail states (cm^-3/eV)
 * *wtd       characteristic decay energy for donor-like tail states (eV)
 * *ngd       density of donor-like Gaussian states (cm^-3/eV)
 * *wgd       characteristic decay energy for donor-like Gaussian states (eV)
 * *egd       peak energy for donor-like Gaussian states (eV)
 */
//定义种子数，每次运行仿真时才会变动
//srand(seed);

int defects(double x, double y, double z, double *nta, double *wta, double *nga, double *wga, double *ega, double *ntd, double *wtd, double *ngd, double *wgd, double *egd)
{

    if (nga == NULL || ngd==NULL)
    {
        printf("Error: nga/ngd pointer is NULL\n");
        return(1); // 返回错误码
    }

	if (y>=100.0){
		//2024.10.26 ngd和nga的数值等于掺杂浓度，因此在这里对缺陷密度乘以一个比例
		//*ngd = *ngd * (*ngd / 1e20) * 0.5 * 1e-3 * exp(-pow(1-modf(y, &y), 2) / 2*pow(2,2));//ngd递增
		*ngd = *ngd * exp(-pow(1-modf(y, &y), 2) / 2*pow(2,2));//ngd递增
		*nga = *nga * exp(-pow(1-modf(y, &y), 2) / 2*pow(2,2));
	}
    else{
		*nga = (*nga) * exp(-pow(y, 2) / 2*pow(2.5,2));//nga递减
		*ngd = (*ngd) * exp(-pow(y, 2) / 2*pow(2.5,2));
	}
	//if(*ngd<1.0e15){*ngd=1.0e15;}
	//if(*nga<1.0e15){*nga=1.0e15;}
	printf("f.defects called with x=%.2f, y=%.2f, nga=%.3e, ngd=%.3e\n", x, y,*nga,*ngd);

	return(0);
}


/*
 * Defect definition
 * Statement: INTDEFECTS
 * Parameter: F.INTDEFECTS
 * Arguments:
 * x          location x (microns)
