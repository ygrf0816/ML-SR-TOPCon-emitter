/*
 * General field dependent mobility model for electrons.
 * TOtal FIeld Mobility (parallel and perpendicular field components)
 * Statement: MATERIAL/MOBILITY
 * Parameter: F.TOFIMUN
 * Arguments:
 * Eperp    [in] - perpendicular electric field (V/cm)
 * Na       [in] - acceptor concentration  (/cm^3)
 * Nd       [in] - donor concentration     (/cm^3)
 * nconc    [in] - electron concentration  (/cm^3)
 * Epar     [in] - parallel electric field (V/cm)
 * TL       [in] - lattice temperature     (K)
 * xcomp    [in] - x-species fraction      (0-1)
 * ycomp    [in] - y-species fraction      (0-1)
 * 
 * *mun     [return] - hole mobility (cm^2/Vs)
 * *dmundep [return] - derivative of *mun wrt Eperp
 * *dmundepar [return] - derivative of *mun wrt Epar
 * *dmundl  [return] - derivative of *mun wrt TL
 * *dmundn  [return] - derivative of *mun wrt nconc

*/


int tofimun(double Eperp,double Na,double Nd,double nconc,double Eparl,double TL,double xcomp,double ycomp,double *mun,double *dmundep,double *dmundepar,double *dmundl,double *dmundn)
{
/* Example is Caughey-Thomas with Beta = 2.5 */
   double mu0 = 1000.0;
   double t1, t2, tmp;
   double vsat=2.0e6;
   double beta=2.5,f=Eparl;

   t1 = pow(mu0*f/vsat,beta);

   t2 = 1.0/(1.0+t1);

   tmp = pow(t2,1.0/beta);

   *mun = mu0*tmp;

   *dmundepar = -(*mun)*t1*t2/f;

   *dmundep=0.0;
   *dmundl =0.0;
   *dmundn = 0.0;

   return(0);
}


/*
 * General field dependent mobility model for holes.
 * TOtal FIeld Mobility (parallel and perpendicular field components)
 * Statement: MATERIAL/MOBILITY
 * Parameter: F.TOFIMUP
 * Arguments:
 * Eperp    [in] - perpendicular electric field (V/cm)
 * Na       [in] - acceptor concentration  (/cm^3)
 * Nd       [in] - donor concentration     (/cm^3)
 * pconc    [in] - hole concentration      (/cm^3)
 * Epar     [in] - parallel electric field (V/cm)
 * TL       [in] - lattice temperature     (K)
 * xcomp    [in] - x-species fraction      (0-1)
 * ycomp    [in] - y-species fraction      (0-1)
 * 
 * *mup     [return] - hole mobility (cm^2/Vs)
 * *dmupdep [return] - derivative of *mup wrt Eperp
 * *dmupdepar [return] - derivative of *mup wrt Epar
 * *dmupdl  [return] - derivative of *mup wrt TL
 * *dmupdp  [return] - derivative of *mup wrt pconc

*/


int tofimup(double Eperp,double Na,double Nd,double pconc,double Eparl,double TL,double xcomp,double ycomp,double *mup,double *dmupdep,double *dmupdepar,double *dmupdl,double *dmupdp)
{
	*mup = 500;

	*dmupdepar = 0.0;
	*dmupdep   = 0.0;
	*dmupdl    = 0.0;
	*dmupdp    = 0.0;

	return(0);
}



/*
 * Position and potential dependent electron mobility model.
 * Statement: MATERIAL/MOBILITY
 * Parameter: F.LOCALMUN
 * Arguments:
 * na    acceptor concentration (per cc)
 * nd    donor concentration (per cc)
 * e     electric field (V/cm)
 * pot   potential Volts
 * tl    lattice temperature (K)
 * Tn    electron temperature (K)
 * pos   pos[0] = x-coord, pos[1] = y-coord pos[2] = z-coord  (cm)
 * *mu   [return] field dependent mobility (cm^2/Vs)
 * *dmde [return] derivative of mu with e
 * *dmdv [return] derivative of mu with pot
 * *dmdtl [return] derivative of mu with Tl
 * *dmdtn [return] derivative of mu with Tn
 */

int localmun(double na, double nd, double e, double pot,double Tl,double Tn,double *pos,double *mu,double *dmde,double *dmdv,double *dmdtl,double *dmdtn)   
{
    const double mobmin=10.0;
/*
 The following shows a mobility which decreases as the square of the distance
 from the origin of the devcie 
 */

   *mu = 1000.0 - 1.0e10*(pos[0]*pos[0] + pos[1]*pos[1] + pos[2]*pos[2]);

    if (*mu < mobmin) *mu = mobmin;

    *dmde =  0.0;
    *dmdv =  0.0;
    *dmdtl = 0.0;
    *dmdtn = 0.0;

    return(0);

}


/*
 * Position and potential dependent hole mobility model.
 * Statement: MATERIAL/MOBILITY
 * Parameter: F.LOCALMUP
 * Arguments:
 * na    acceptor concentration (per cc)
 * nd    donor concentration (per cc)
 * e     electric field (V/cm)
 * pot   potential Volts
 * tl    lattice temperature (K)
 * Tp    hole temperature (K)
 * pos   pos[0] = x-coord, pos[1] = y-coord pos[2] = z-coord  (cm)
 * *mu   [return] field dependent mobility (cm^2/Vs)
 * *dmde [return] derivative of mu with e
 * *dmdv [return] derivative of mu with pot
 * *dmdtl [return] derivative of mu with Tl
 * *dmdtp [return] derivative of mu with Tp
 */

int localmup(double na, double nd, double e, double pot,double Tl,double Tp,double *pos,double *mu,double *dmde,double *dmdv,double *dmdtl,double *dmdtp)   
{
    const double mobmin=10.0;
/*
 * The following example shows a mobility with a linear dependence on
 * device potential
 */

    *mu = 1000.0 - pot*100;

    if (*mu < mobmin) *mu = mobmin;

    *dmde =  0.0;
    *dmdv =  100.0;
    *dmdtl = 0.0;
    *dmdtp = 0.0;

    return(0);
}

/*
 * Temperature and concentration dependent phonon drag contribution to
 * electron thermopower in GIGA
 * Statement: MATERIAL/MODELS
 * Parameter: F.PDN
 * Arguments:
 * TL - Lattice Temperature (Kelvin)      [in]
 * nconc -  Electron concentration (/cc)  [in]
 *  *dp  -  Phonon drag contribution      [out]
 *  *dpddt - derivative of *pd w.r.t. TL  [out]
 *  *dpddc - derivative of *pd w.r.t. nconc [out]
 */
int fphonondragn(double TL, double nconc,double *pd, double *dpddt,double *dpddc)
{
	*pd = 0.1 * pow(TL/300.0,-3.5);
	*dpddt = -3.5/TL * (*pd);
	*dpddc = 0.0;
	return(0);
}

/*
 * Temperature and concentration dependent phonon drag contribution to
 * hole thermopower in GIGA
 * Statement: MATERIAL/MODELS
 * Parameter: F.PDP
 * Arguments:
 * TL - Lattice Temperature (Kelvin)      [in]
 * pconc -  Hole concentration (/cc)      [in]
 *  *pd  -  Phonon drag contribution      [out]
 *  *dpddt - derivative of *pd w.r.t. TL  [out]
 *  *dpddc - derivative of *pd w.r.t. pconc [out]
 */
int fphonondragp(double TL, double pconc,double *pd, double *dpddt,double *dpddc)
{
	*pd = 0.1 * pow(TL/300.0,-3.5);
	*dpddt = -3.5/TL * (*pd);
	*dpddc = 0.0;
	return(0);
}

