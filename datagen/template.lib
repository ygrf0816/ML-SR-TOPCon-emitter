 * Arguments:
 * egp        Energy Gap on "plus" side (eV)
 * egm        Energy Gap on "minus" side (eV)
 * ncp        Conduction density of states on "plus" side (per cc)
 * ncm        Conduction density of states on "minus" side (per cc)
 * nvp        Valence density of states on "plus" side (per cc)
 * nvm        Valence density of states on "minus" side (per cc)
 * vnp        electron thermal velocity on "plus" side (cm/s)
 * vnm        electron thermal velocity on "minus" side (cm/s)
 * vpp        hole thermal velocity on "plus" side (cm/s)
 * vpm        hole thermal velocity on "minus" side (cm/s)
 * nplus      electron concentration on "plus" side (per cc)
 * nminus     electron concentration on "minus" side (per cc)
 * pplus      hole concentration on "plus" side (per cc)
 * pminus     hole concentration on "minus" side (per cc)
 * deltaec    conduction band edge discontinuity (eV)
 * temp       temperature (K)
 * jn         electron emission current (A/sqcm)
 * djndnp     derivative of emission current with respect to nplus
 * djndnm     derivative of emission current with respect to nminus
 * djndpp     derivative of emission current with respect to pplus
 * djndpm     derivative of emission current with respect to pminus
 */
int hten(double egp, double egm, double ncp, double ncm, double nvp, double nvm, double vnp, double vnm, double vpp, double vpm, double nplus, double nminus, double pplus, double pminus, double deltaec, double temp, double *jn, double *djndnp, double *djndnm, double *djndpp, double *djndpm)
{
