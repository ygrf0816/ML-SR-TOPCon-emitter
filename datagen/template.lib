/*
 * Multistate trap configuration transfer rates .
 * Statement: INTTRAP
 * Parameter: F.MSCRATES 
 * Arguments:
 * i          [in]     starting state (from 1 up to number of states)
 * j          [in]     final state    (from 1 up to number of states)
 * ec         [in]     conduction band energy (eV)
 * ev         [in]     valence band energy (eV)
 * qfn        [in]     energy of electron quasi-fermi level (eV)  
 * qfp        [in]     energy of hole quasi-fermi level (eV)
 * *etrap     [in]     array of energy levels associated with each trap state (eV)
 * fn         [in]     electron concentration  (c.c.)
 * fp         [in]     hole concentration (c.c.)
 * ttl        [in]     lattice temperature (Kelvin)
 * ttn        [in]     electron temperature (Kevin)
 * ttp        [in]     hole temperature (Kelvin)
 * species1   [in]     concentration of species 1 or atomic hydrogen (c.c.) 
 * species2   [in]     concentration of species 2 or molecular hydrogen (c.c.)
 * species3   [in]     concentration of species 3 (c.c.)
 * field      [in]     insulator field (V/cm)
 * *rate      [return] transition rate from state i to j in units of /second
 * *setderivs [return] set to 1 if you are also specifying derivatives of rates
 * *derivs    [return] this is an array for storing set of derivatives w.r.t.
 *                     each input quantity. Array indices are defined as
 *                     constants for convenience.  
 */
/*  All energies refer to electron energy and have same reference energy so
all energy differences are obtained by simple subracction */
/* Example is for 3-state NBTI  model  */
int msctransitionrates(int i, int j, double ec, double ev, double qfn, double qfp, double *etrap, double fn, double fp, double ttl, double ttn, double ttp, double species1, double species2, double species3, double field, double *rate, int *setderivs, double *derivs)
{
/* use these constants as argument to derivs array if setting derivatives */
/* If hydrogen transport is enabled instead of generic ionic species then
species1 is atomic hydrogen and species2 is molecular hydrogen */
const int QFN=0;const int QFP=1;const int ELEC=2;const int HOLE=3;
const int TTL=4;const int TTN=5;const int TTP=6;const int SP1=7;
const int SP2=8;const int SP3=9;const int FLD=10;
const double BOLTS=8.617346815e-5; 
double vth_p,vth_n,sigma_p,sigma_n,Delta_MPE_p,Delta_MPE_n,Fc;

/* Initialise derivative w.r.t. each input quantity to be zero */
derivs[QFN] = 0;
derivs[QFP] = 0;
derivs[ELEC] = 0;
derivs[HOLE] = 0;
derivs[TTL] = 0;
derivs[TTN] = 0;
derivs[TTP] = 0;
derivs[SP1] = 0;
derivs[SP2] = 0;
derivs[SP3] = 0;
derivs[FLD]=0;
*setderivs=1;

vth_p=1.5e7;vth_n=1.0e7;sigma_p=3.0e-14;sigma_n=1.0e-16,Delta_MPE_p=0.054;Delta_MPE_n=0.02;Fc=1.0e7;

*rate=0.0;
 
switch (i)
{
    case 1:
	if (j==2)
	{	
	    *rate=fp*vth_p*sigma_p*exp(-Delta_MPE_p/(BOLTS*ttl))*(ev-etrap[0] > 0 ? exp((etrap[0]-ev)/(BOLTS*ttl)) : 1.0)*exp(field*field/(Fc*Fc));
            derivs[HOLE] = vth_p*sigma_p*exp(-Delta_MPE_p/(BOLTS*ttl))*(ev-etrap[0] > 0 ? exp((etrap[0]-ev)/(BOLTS*ttl)) : 1.0)*exp(field*field/(Fc*Fc));
            (*rate)= (*rate) + fn*vth_n*sigma_n*exp(-Delta_MPE_p/(BOLTS*ttl))*(etrap[0]-ec > 0 ? exp((ec-qfn)/(BOLTS*ttl)) : exp((etrap[0]-qfn)/(BOLTS*ttl)));
            derivs[ELEC]=vth_n*sigma_n*exp(-Delta_MPE_p/(BOLTS*ttl))*(etrap[0]-ec > 0 ? exp((ec-qfn)/(BOLTS*ttl)) : exp((etrap[0]-qfn)/(BOLTS*ttl)));
            derivs[QFN] = fn*vth_n*sigma_n*exp(-Delta_MPE_p/(BOLTS*ttl))*(etrap[0]-ec > 0 ? -exp((ec-qfn)/(BOLTS*ttl))/(BOLTS*ttl) : -exp((etrap[0]-qfn)/(BOLTS*ttl))/(BOLTS*ttl)); 
	}
        else if (j==3)
	{
	    *rate=0.0;
	}
	else
	   puts("Error: index not handled");

    break;
    case 2:
	if (j==1)
	{	
	   *rate=0.0;
	}
        else if (j==3)
	{
	  
 	   *rate     = fp*vth_p*sigma_p*exp(-Delta_MPE_n/(BOLTS*ttl))*(ev-etrap[1] > 0.0 ? exp(-(ev-qfp)/(BOLTS*ttl)) : exp(-(etrap[1]-qfp)/(BOLTS*ttl)));
           derivs[HOLE] = vth_p*sigma_p*exp(-Delta_MPE_n/(BOLTS*ttl))*(ev-etrap[1] > 0.0 ? exp(-(ev-qfp)/(BOLTS*ttl)) : exp(-(etrap[1]-qfp)/(BOLTS*ttl)));
           derivs[QFP]  = fp*vth_p*sigma_p*exp(-Delta_MPE_n/(BOLTS*ttl))*(ev-etrap[1] > 0.0 ? exp(-(ev-qfp)/(BOLTS*ttl))/(BOLTS*ttl) : exp(-(etrap[1]-qfp)/(BOLTS*ttl))/(BOLTS*ttl));
           (*rate) = (*rate) + fn*vth_n*sigma_n*exp(-Delta_MPE_n/(BOLTS*ttl))*(etrap[1]-ec > 0.0 ? exp(-(etrap[1]-ec)/(BOLTS*ttl)) : 1.0);
           derivs[ELEC] = vth_n*sigma_n*exp(-Delta_MPE_n/(BOLTS*ttl))*(etrap[1]-ec > 0.0 ? exp(-(etrap[1]-ec)/(BOLTS*ttl)) : 1.0); 
	}
	else
	   puts("Error: index not handled");

    break;
    case 3:
	if (j==1)
	{	
           *rate=0.0;
	}
        else if (j==2)
	{
	   *rate     = fp*vth_p*sigma_p*exp(-Delta_MPE_n/(BOLTS*ttl))*(ev-etrap[1] > 0.0? exp((etrap[1]-ev)/(BOLTS*ttl)): 1.0);
           derivs[HOLE] = vth_p*sigma_p*exp(-Delta_MPE_n/(BOLTS*ttl))*(ev-etrap[1] > 0.0 ? exp((etrap[1]-ev)/(BOLTS*ttl)): 1.0);
           (*rate) = (*rate) + fn*vth_n*sigma_n*exp(-Delta_MPE_n/(BOLTS*ttl))*(etrap[1]-ec > 0 ? exp((ec-qfn)/(BOLTS*ttl)) : exp((etrap[1]-qfn)/(BOLTS*ttl)));
           derivs[ELEC]=vth_n*sigma_n*exp(-Delta_MPE_n/(BOLTS*ttl))*(etrap[1]-ec > 0 ? exp((ec-qfn)/(BOLTS*ttl)) : exp((etrap[1]-qfn)/(BOLTS*ttl)));
           derivs[QFN] = fn*vth_n*sigma_n*exp(-Delta_MPE_n/(BOLTS*ttl))*(etrap[1]-ec > 0 ? -exp((ec-qfn)/(BOLTS*ttl))/(BOLTS*ttl) : -exp((etrap[1]-qfn)/(BOLTS*ttl))/(BOLTS*ttl)); 
	}
	else
	   puts("Error: index not handled");
    break;
    default:
	puts("Error: index not handled");
    break;
}
return(0);
}

/*
 * Extended version of Multistate trap configuration transfer rates.
 * Statement: INTTRAP
 * Parameter: F.EXTMSCRATE 
 * Arguments:
 * i          [in]     starting state (from 1 up to number of states)
 * j          [in]     final state    (from 1 up to number of states)
 * ec         [in]     conduction band energy (eV)
 * ev         [in]     valence band energy (eV)
 * qfn        [in]     energy of electron quasi-fermi level (eV)  
 * qfp        [in]     energy of hole quasi-fermi level (eV)
 * *etrap     [in]     array of energy levels associated with each trap state (eV)
 * fn         [in]     electron concentration  (c.c.)
 * fp         [in]     hole concentration (c.c.)
 * ttl        [in]     lattice temperature (Kelvin)
 * ttn        [in]     electron temperature (Kevin)
 * ttp        [in]     hole temperature (Kelvin)
 * species1   [in]     concentration of species 1 or atomic hydrogen (c.c.) 
 * species2   [in]     concentration of species 2 or molecular hydrogen (c.c.)
 * species3   [in]     concentration of species 3 (c.c.)
 * field      [in]     insulator field (V/cm)
 * sign       [in]     electron cross-section in cm^2
 * sigp       [in]     hole cross-section in cm^2
 * photon_energy  [in] photon energy in eV  
 * beam_intensity [in] beam power in W/cm^3
 * *rate      [return] transition rate from state i to j in units of /second
 * *setderivs [return] set to 1 if you are also specifying derivatives of rates
 * *derivs    [return] this is an array for storing set of derivatives w.r.t.
 *                     each input quantity. Array indices are defined as
 *                     constants for convenience.  
 */
int mscextendedtransitionrates(int i, int j, double ec, double ev, double qfn, double qfp, double *etrap, double fn, double fp, double ttl, double ttn, double ttp, double species1, double species2, double species3, double field, double sign,double sigp,double photon_energy,double beam_intensity,double *rate, int *setderivs, double *derivs)
{
/* use these constants as argument to derivs array if setting derivatives */
/* If hydrogen transport is enabled instead of generic ionic species then
species1 is atomic hydrogen and species2 is molecular hydrogen */
const int QFN=0;const int QFP=1;const int ELEC=2;const int HOLE=3;
const int TTL=4;const int TTN=5;const int TTP=6;const int SP1=7;
const int SP2=8;const int SP3=9;const int FLD=10;
const double BOLTS=8.617346815e-5; 
double vth_p,vth_n,sigma_p,sigma_n,Delta_MPE_p,Delta_MPE_n,Fc;

/* Initialise derivative w.r.t. each input quantity to be zero */
derivs[QFN] = 0;
derivs[QFP] = 0;
derivs[ELEC] = 0;
derivs[HOLE] = 0;
derivs[TTL] = 0;
derivs[TTN] = 0;
derivs[TTP] = 0;
derivs[SP1] = 0;
derivs[SP2] = 0;
derivs[SP3] = 0;
derivs[FLD]=0;
*setderivs=1;

vth_p=1.5e7;vth_n=1.0e7;sigma_p=3.0e-14;sigma_n=1.0e-16,Delta_MPE_p=0.054;Delta_MPE_n=0.02;Fc=1.0e7;

*rate=0.0;
 
switch (i)
{
    case 1:
	if (j==2)
	{	
	    *rate=fp*vth_p*sigma_p*exp(-Delta_MPE_p/(BOLTS*ttl))*(ev-etrap[0] > 0 ? exp((etrap[0]-ev)/(BOLTS*ttl)) : 1.0)*exp(field*field/(Fc*Fc));
            derivs[HOLE] = vth_p*sigma_p*exp(-Delta_MPE_p/(BOLTS*ttl))*(ev-etrap[0] > 0 ? exp((etrap[0]-ev)/(BOLTS*ttl)) : 1.0)*exp(field*field/(Fc*Fc));
            (*rate)= (*rate) + fn*vth_n*sigma_n*exp(-Delta_MPE_p/(BOLTS*ttl))*(etrap[0]-ec > 0 ? exp((ec-qfn)/(BOLTS*ttl)) : exp((etrap[0]-qfn)/(BOLTS*ttl)));
            derivs[ELEC]=vth_n*sigma_n*exp(-Delta_MPE_p/(BOLTS*ttl))*(etrap[0]-ec > 0 ? exp((ec-qfn)/(BOLTS*ttl)) : exp((etrap[0]-qfn)/(BOLTS*ttl)));
            derivs[QFN] = fn*vth_n*sigma_n*exp(-Delta_MPE_p/(BOLTS*ttl))*(etrap[0]-ec > 0 ? -exp((ec-qfn)/(BOLTS*ttl))/(BOLTS*ttl) : -exp((etrap[0]-qfn)/(BOLTS*ttl))/(BOLTS*ttl)); 
	}
        else if (j==3)
	{
	    *rate=0.0;
	}
	else
	   puts("Error: index not handled");

    break;
    case 2:
	if (j==1)
	{	
	   *rate=0.0;
	}
        else if (j==3)
	{
	  
 	   *rate     = fp*vth_p*sigma_p*exp(-Delta_MPE_n/(BOLTS*ttl))*(ev-etrap[1] > 0.0 ? exp(-(ev-qfp)/(BOLTS*ttl)) : exp(-(etrap[1]-qfp)/(BOLTS*ttl)));
           derivs[HOLE] = vth_p*sigma_p*exp(-Delta_MPE_n/(BOLTS*ttl))*(ev-etrap[1] > 0.0 ? exp(-(ev-qfp)/(BOLTS*ttl)) : exp(-(etrap[1]-qfp)/(BOLTS*ttl)));
           derivs[QFP]  = fp*vth_p*sigma_p*exp(-Delta_MPE_n/(BOLTS*ttl))*(ev-etrap[1] > 0.0 ? exp(-(ev-qfp)/(BOLTS*ttl))/(BOLTS*ttl) : exp(-(etrap[1]-qfp)/(BOLTS*ttl))/(BOLTS*ttl));
           (*rate) = (*rate) + fn*vth_n*sigma_n*exp(-Delta_MPE_n/(BOLTS*ttl))*(etrap[1]-ec > 0.0 ? exp(-(etrap[1]-ec)/(BOLTS*ttl)) : 1.0);
           derivs[ELEC] = vth_n*sigma_n*exp(-Delta_MPE_n/(BOLTS*ttl))*(etrap[1]-ec > 0.0 ? exp(-(etrap[1]-ec)/(BOLTS*ttl)) : 1.0); 
	}
	else
	   puts("Error: index not handled");

    break;
    case 3:
	if (j==1)
	{	
           *rate=0.0;
	}
        else if (j==2)
	{
	   *rate     = fp*vth_p*sigma_p*exp(-Delta_MPE_n/(BOLTS*ttl))*(ev-etrap[1] > 0.0? exp((etrap[1]-ev)/(BOLTS*ttl)): 1.0);
           derivs[HOLE] = vth_p*sigma_p*exp(-Delta_MPE_n/(BOLTS*ttl))*(ev-etrap[1] > 0.0 ? exp((etrap[1]-ev)/(BOLTS*ttl)): 1.0);
           (*rate) = (*rate) + fn*vth_n*sigma_n*exp(-Delta_MPE_n/(BOLTS*ttl))*(etrap[1]-ec > 0 ? exp((ec-qfn)/(BOLTS*ttl)) : exp((etrap[1]-qfn)/(BOLTS*ttl)));
           derivs[ELEC]=vth_n*sigma_n*exp(-Delta_MPE_n/(BOLTS*ttl))*(etrap[1]-ec > 0 ? exp((ec-qfn)/(BOLTS*ttl)) : exp((etrap[1]-qfn)/(BOLTS*ttl)));
           derivs[QFN] = fn*vth_n*sigma_n*exp(-Delta_MPE_n/(BOLTS*ttl))*(etrap[1]-ec > 0 ? -exp((ec-qfn)/(BOLTS*ttl))/(BOLTS*ttl) : -exp((etrap[1]-qfn)/(BOLTS*ttl))/(BOLTS*ttl)); 
	}
	else
	   puts("Error: index not handled");
    break;
    default:
	puts("Error: index not handled");
    break;
}
return(0);
}


