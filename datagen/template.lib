/*
 * Microscopic Noise Source for electron diffusion noise.
 * Statement: MATERIAL
 * Parameter: F.MNSNDIFF
 * Arguments:
 * xcomp      composition fraction x
 * ycomp      composition fraction y
 * temp       lattice temperature (K)
 * n          electron concentration (cm^-3)
 * mun        electron mobility (cm^2/V s)
 * e          electric field (V/cm)
 * *mns       microscopic noise source (s A^2 / cm)
 */
int mnsndiff(double xcomp, double ycomp, double temp, double n, double mun, double e, double *mns)
{
/*
 * The following body is set up to emulate the default function
 * implemented in ATLAS.
 *
 * The mns is 4.q^2.n.D, where D is the diffusion coefficient given
 * by the Einstein relationship D=(kT/q).mun
 */
        const double q=1.602e-19;
        const double k=1.381e-23;
        double d;

        d=(k*temp / q) * mun;
        *mns=4.0*q*q*n*d;

        return(0);                /* 0 - ok */
}

/*
 * Microscopic Noise Source for hole diffusion noise.
 * Statement: MATERIAL
 * Parameter: F.MNSPDIFF
 * Arguments:
 * xcomp      composition fraction x
 * ycomp      composition fraction y
 * temp       lattice temperature (K)
 * p          hole concentration (cm^-3)
 * mup        hole mobility (cm^2 / V s)
 * e          electric field (V / cm)
 * *mns       microscopic noise source (s A^2 / cm)
 */
int mnspdiff(double xcomp, double ycomp, double temp, double p, double mup, double e, double *mns)
{
/*
 * The following body is set up to emulate the default function
 * implemented in ATLAS.
 *
 * The mns is 4.q^2.p.D, where D is the diffusion coefficient given
 * by the Einstein relationship D=(kT/q).mup
 */
        const double q=1.602e-19;
        const double k=1.381e-23;
        double d;

        d=(k*temp / q) * mup;
        *mns=4.0*q*q*p*d;

        return(0);                /* 0 - ok */
}

/*
 * Microscopic Noise Source for electron flicker (1/f) noise.
 * Statement: MATERIAL
 * Parameter: F.MNSNFLICKER
 * Arguments:
 * x          location x (microns)
 * y          location y (microns)
 * temp       lattice temperature (K)
 * n          electron concentration (cm^-3)
 * jn         electron current density (A / cm^2)
 * f          frequency (Hz)
 * e          electric field (V / cm)
 * *mns       microscopic noise source (s A^2 / cm)
 */
int mnsnflicker(double x, double y, double temp, double n, double jn, double f, double e, double *mns)
{
/*
 * The following body is set up to emulate the default function
 * implemented in ATLAS.
 *
 * The mns is (alpha/f)*(j^2/n), where alpha is the Hooge constant.
 */
        const double alpha=2.0e-3;

        *mns= (n > 1.0) ? (alpha/f) * (jn*jn/n) : 0.0;

        return (0);
}

/*
 * Microscopic Noise Source for hole flicker (1/f) noise.
 * Statement: MATERIAL
 * Parameter: F.MNSPFLICKER
 * Arguments:
 * x          location x (microns)
 * y          location y (microns)
 * temp       lattice temperature (K)
 * p          hole concentration (cm^-3)
 * jp         hole current density (A / cm^2)
 * f          frequency (Hz)
 * e          electric field (V / cm)
 * *mns       microscopic noise source (s A^2 / cm)
 */
int mnspflicker(double x, double y, double temp, double p, double jp, double f, double e, double *mns)
{
/*
 * The following body is set up to emulate the default function
 * implemented in ATLAS.
 *
 * The mns is (alpha/f)*(j^2/n), where alpha is the Hooge constant.
 */
        const double alpha=2.0e-3;

        *mns= (p > 1.0) ? (alpha/f) * (jp*jp/p) : 0.0;

        return (0);
}


/* Example C-interpreter function for Valence band effective density of
 states as a function of Temperature [ NV (T) ] 
 * Statement: MATERIAL
 * Parameter: F.VBDOSFN
 */
/* Input variables 
 * xcomp - composition x-fraction if ternary or quaternary alloy
 * ycomp - composition y-fraction if quaternary alloy 
 *  temp  - Carrier temperature in Kelvin  */
/* Output variables
   *nv - density of states in /c.c.  
   *dnvdt - d (*nv) / d (temp) in ) in /c.c./Kelvin  
   (Note 1 : an exact derivative is not required, but a poor approximation 
    of the derivative may compromise convergence properties).
   (Note 2 : a complete implementation is included for instructional
    purposes. Replace with your model. */

int vbdosfn(double xcomp,double ycomp,double temp, double* nv, double* dnvdt)
{

/*
 * The following body is set up to emulate the default function
 * implemented in ATLAS, where NV300 is the valence band effective
 * density of states for the material at 300 K
 */
	double NV300 = 1.0e19;

	(*nv) = NV300 * pow(temp/300.0,1.5);
	(*dnvdt) = 1.5 * NV300/300.0 * pow(temp/300.0,0.5);

	return(0);  /*  0 - ok */
}

/* Example C-interpreter function for Conduction band density of states as a
function of Temperature NC (T) 
 * Statement: MATERIAL
 * Parameter: F.CBDOSFN
 */
/* Input variables 
 *  xcomp - composition x-fraction if ternary or quaternary alloy
 *  ycomp - composition y-fraction if quaternary alloy 
 *  temp  - Carrier temperature in Kelvin  */
/* Output variables
   *nc - density of states in /c.c.  
   *dncdt - d (*nc) / d (temp) in ) in /c.c./Kelvin  
   (Note 1 : an exact derivative is not required, but a poor approximation 
    of the derivative may compromise convergence properties).
   (Note 2 : a complete implementation for a two-valley model is
    included for instructional purposes. Replace with your model. */


int cbdosfn(double xcomp,double ycomp,double temp, double* nc, double* dncdt)
{
	double dos[3]={4.351915487E17,1.13552E19,2.12393E19};
	double factor,dfactordt,alpha=0.001,T0=400.0;
	double tempdep,dtempdepdt;

	factor = 1.0/(1.0+exp(alpha*(temp-T0)));

	tempdep=pow(temp/300.0,1.5);

	dtempdepdt=1.5*pow(temp/300.0,0.5)/300.0;

	dfactordt=-alpha*exp(alpha*(temp-T0))*factor*factor;

	*nc = factor*dos[0]*pow(temp/300.0,1.5) + (1.0-factor)*dos[1]*pow(temp/300.0,1.5);

	*dncdt = (dtempdepdt*factor+dfactordt*tempdep)*(dos[0]-dos[1]) + dos[1]*dtempdepdt;

	return(0);
}

/*
 * General carrier temperature dependent mobility model for electrons.
 * Statement: MATERIAL/MOBILITY
 * Parameter: F.ENMUN
 * Arguments:
 * Eperp    [in] - perpendicular electric field (V/cm)
 * Na       [in] - acceptor concentration  (/cm^3)
 * Nd       [in] - donor concentration     (/cm^3)
 * nconc    [in] - electron concentration  (/cm^3)
 * Tn       [in] - electron temperature    (K)
 * TL       [in] - lattice temperature     (K)
 * xcomp    [in] - x-species fraction      (0-1)
 * ycomp    [in] - y-species fraction      (0-1)
 * 
 * *mun     [return] - mobility (cm^2/Vs)
 * *dmundep [return] - derivative of *mun wrt Eperp
 * *dmundl  [return] - derivative of *mun wrt TL
 * *dmundtn [return] - derivative of *mun wrt Tn
 * *dmundn  [return] - derivative of *mun wrt nconc 
 *
 */

int endepmun(double Eperp, double Na, double Nd, double nconc, double Tn, double TL, double xcomp, double ycomp, double* mun, double* dmundep, double* dmundl, double* dmundtn, double *dmundn)
{
/* Example, Constant Low field mobility from ATLAS manual */

	double tmun=1.0,nmu=8000.0;

	*mun=nmu*pow(TL/300.0,-tmun);

	*dmundep=0.0;
	*dmundl= - tmun * (*mun) / TL;
	*dmundtn=0.0;
	*dmundn=0.0;

	return(0);
}

/*
 * General carrier temperature dependent mobility model for holes.
 * Statement: MATERIAL/MOBILITY
 * Parameter: F.ENMUP
 * Arguments:
 * Eperp    [in] - perpendicular electric field (V/cm)
 * Na       [in] - acceptor concentration  (/cm^3)
 * Nd       [in] - donor concentration     (/cm^3)
 * pconc    [in] - hole concentration      (/cm^3)
 * Tp       [in] - hole temperature        (K)
 * TL       [in] - lattice temperature     (K)
 * xcomp    [in] - x-species fraction      (0-1)
 * ycomp    [in] - y-species fraction      (0-1)
 * 
 * *mup     [return] - hole mobility (cm^2/Vs)
 * *dmupdep [return] - derivative of *mup wrt Eperp
 * *dmupdl  [return] - derivative of *mup wrt TL
 * *dmupdtp [return] - derivative of *mup wrt Tp
 * *dmupdp  [return] - derivative of *mup wrt pconc
*/

int endepmup(double Eperp, double Na, double Nd, double pconc, double Tp, double TL, double xcomp, double ycomp, double *mup, double *dmupdep, double *dmupdl, double *dmupdtp, double *dmupdp)
{
/* Example, Constant Low field mobility for GaAS from ATLAS manual */

	double tmup=2.1,pmu=400.0;

	*mup=pmu*pow(TL/300.0,-tmup);

	*dmupdep= 0.0;
	*dmupdl = -tmup* (*mup)/TL;
	*dmupdtp= 0.0;
	*dmupdp = 0.0;

	return(0);
}

